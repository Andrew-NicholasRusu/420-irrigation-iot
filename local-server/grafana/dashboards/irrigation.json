        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "irrigation-sqlite"
          },
          "queryText": "SELECT COUNT(*) AS \"Buffered\"\nFROM sensor_readings\nWHERE received_at >= datetime('now', '-1 hour')\n  AND strftime('%s', received_at) - strftime('%s', collected_at) > 60",
          "rawQueryText": "SELECT COUNT(*) AS \"Buffered\"\nFROM sensor_readings\nWHERE received_at >= datetime('now', '-1 hour')\n  AND strftime('%s', received_at) - strftime('%s', collected_at) > 60",
