          "queryText": "SELECT CAST(strftime('%s', collected_at) AS INTEGER) AS time, temperature AS \"Temperature\"\nFROM sensor_readings\nWHERE CAST(strftime('%s', collected_at) AS INTEGER) BETWEEN $__from / 1000 AND $__to / 1000\n  AND temperature IS NOT NULL\nORDER BY time",
          "rawQueryText": "SELECT CAST(strftime('%s', collected_at) AS INTEGER) AS time, temperature AS \"Temperature\"\nFROM sensor_readings\nWHERE CAST(strftime('%s', collected_at) AS INTEGER) BETWEEN $__from / 1000 AND $__to / 1000\n  AND temperature IS NOT NULL\nORDER BY time",
